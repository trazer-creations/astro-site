---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

// src/pages/shop.astro
import { getCollection } from 'astro:content';

// 1. Fetch flat lists from GitHub files via Astro Content Layer
const allCategories = await getCollection('categories');
const allProducts = await getCollection('products');

// 2. Reconstruct your original nested "shopData" layout dynamically
const shopData = allCategories.map(categoryEntry => {
  const category = categoryEntry.data;
  
  // Find all products assigned to this category slug
  const matchingProducts = allProducts
    .filter(productEntry => productEntry.data.category === category.slug)
    .map(productEntry => productEntry.data);

  return {
    ...category,
    products: matchingProducts
  };
});
---

<Layout title="Shop">
    {shopData.map(category => (
      <section class="category-block">
        <h2>{category.name}</h2>
        <p>{category.description}</p>
        
        <div class="products-grid">
          {category.products.map(product => (
            <div class="product-card">
              <img src={product.image} alt={product.name} />
              <h3>{product.name}</h3>
              <p>${product.price.toFixed(2)}</p>
              <ul>
                {product.features.map(feature => <li>{feature}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>
    ))}
	<Card />
  </Layout>