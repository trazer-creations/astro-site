---
import Layout from '../layouts/Layout.astro';
import { shopData } from '../data/shopData';

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout title="Artisanal Chocolate Storefront">
	<section class="relative bg-stone-900 text-white py-24 px-4 bg-[url('https://images.unsplash.com/photo-1511381939415-e44015466834?auto=format&fit=crop&w=1600&q=80')] bg-cover bg-center bg-blend-overlay bg-opacity-70">
		<div class="max-w-4xl mx-auto text-center space-y-6">
			<h1 class="text-4xl md:text-6xl font-serif font-extrabold tracking-tight text-amber-100">
				Crafted with Passion, Devoured with Pleasure.
			</h1>
			<p class="text-lg md:text-xl text-stone-200 max-w-2xl mx-auto">
				Explore our curated collection of single-origin dark chocolate, hand-rolled truffles, and seasonal confections.
			</p>
			<a href="#categories" class="inline-block bg-amber-600 hover:bg-amber-700 text-white font-semibold px-8 py-3 rounded-md transition shadow-lg">
				Shop Collection
			</a>
		</div>
	</section>

	<section id="categories" class="max-w-6xl mx-auto px-4 py-16 scroll-mt-16">
		<h2 class="text-3xl font-serif font-bold text-center text-stone-900 mb-2">Our Chocolate Categories</h2>
		<p class="text-center text-stone-500 mb-12">Select a category to discover exceptional flavor profiles.</p>
		
		<div class="grid md:grid-cols-2 gap-8">
			{shopData.map((category) => (
				<div class="bg-white rounded-xl overflow-hidden shadow-sm border border-stone-100 hover:shadow-md transition flex flex-col justify-between p-6 md:p-8">
					<div>
						<h3 class="text-2xl font-serif font-bold text-stone-800 mb-2">{category.name}</h3>
						<p class="text-stone-600 text-sm md:text-base mb-6 leading-relaxed">{category.description}</p>
					</div>
					<a 
						href={`/category/${category.slug}`} 
						class="inline-flex items-center justify-between font-semibold text-amber-800 hover:text-amber-900 group border-t border-stone-100 pt-4"
					>
						Browse {category.name}
						<span class="transform group-hover:translate-x-1 transition-transform">&rarr;</span>
					</a>
				</div>
			))}
		</div>
	</section>
</Layout>