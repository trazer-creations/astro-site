---
import '../styles/global.css';
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Gourmet Artisan Chocolate Shop" />
		<meta name="viewport" content="width=device-width" />
		<title>{title} | Cocoa & Co.</title>
	</head>
	<body class="bg-amber-50/40 text-stone-800 font-sans flex flex-col min-h-screen">
		<nav class="bg-stone-900 text-amber-100 shadow-md sticky top-0 z-50">
			<div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
				<a href="/" class="text-2xl font-serif font-bold tracking-wider hover:text-amber-300 transition">
					COCOA & CO.
				</a>
				<div class="space-x-6 text-sm font-medium">
					<a href="/" class="hover:text-amber-300 transition">Home</a>
					<a href="/#categories" class="hover:text-amber-300 transition">Categories</a>
				</div>
			</div>
		</nav>

		<main class="flex-grow">
			<slot />
		</main>

		<footer class="bg-stone-900 text-stone-400 py-8 border-t border-stone-800 text-center text-sm">
			<p>&copy; {new Date().getFullYear()} Cocoa & Co. Artisanal Chocolatiers. All rights reserved.</p>
		</footer>
	</body>
</html>
