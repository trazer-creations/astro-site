---
import Layout from '../../layouts/Layout.astro';
import { shopData } from '../../data/shopData';

// Flatten products array to generate a unique static path for every single item
export async function getStaticPaths() {
  const allProducts = shopData.flatMap((category) => 
    category.products.map((product) => ({
      params: { product: product.slug },
      props: { product, categoryName: category.name, categorySlug: category.slug },
    }))
  );

  return allProducts;
}

const { product, categoryName, categorySlug } = Astro.props;
---

<Layout title={product.name}>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <nav class="text-sm text-stone-500 mb-8">
      <a href="/" class="hover:underline">Home</a> &gt; 
      <a href={`/category/${categorySlug}`} class="hover:underline">{categoryName}</a> &gt; 
      <span class="text-stone-800 font-medium">{product.name}</span>
    </nav>

    <div class="grid md:grid-cols-2 gap-12 items-start">
      <div class="rounded-2xl overflow-hidden shadow-md bg-stone-100">
        <img 
          src={product.image} 
          alt={product.name} 
          class="w-full h-auto aspect-square object-cover"
        />
      </div>

      <div class="space-y-6">
        <div>
          <span class="text-xs font-semibold tracking-wider uppercase text-amber-700 bg-amber-100 px-2.5 py-1 rounded">
            {categoryName}
          </span>
          <h1 class="text-3xl md:text-4xl font-serif font-bold text-stone-950 mt-3 mb-2">{product.name}</h1>
          <p class="text-2xl font-semibold text-amber-900">${product.price.toFixed(2)}</p>
        </div>

        <hr class="border-stone-200" />

        <div class="space-y-2">
          <h3 class="text-sm font-semibold tracking-wide uppercase text-stone-500">Description</h3>
          <p class="text-stone-700 leading-relaxed">{product.description}</p>
        </div>

        <div class="pt-2">
          <div class="flex flex-wrap gap-2">
            {product.features.map((feature) => (
              <span class="text-xs bg-stone-100 text-stone-600 px-3 py-1 rounded-full border border-stone-200">
                ✓ {feature}
              </span>
            ))}
          </div>
        </div>

        <hr class="border-stone-200" />

        <div class="space-y-3">
          <label class="block text-sm font-semibold text-stone-700">Quantity</label>
          <div class="flex gap-4">
            <select class="bg-white border border-stone-300 rounded-md px-4 py-2 text-stone-800 focus:outline-none focus:ring-2 focus:ring-amber-600">
              <option>1</option>
              <option>2</option>
              <option>3</option>
              <option>4</option>
              <option>5</option>
            </select>
            <button 
              onclick="alert('Added to cart! (Simulated functionality)')"
              class="flex-1 bg-amber-700 hover:bg-amber-800 text-white font-medium px-6 py-3 rounded-md transition shadow shadow-amber-900/10 text-center"
            >
              Add to Basket
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

</Layout>